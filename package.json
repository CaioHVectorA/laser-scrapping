{
  "name": "laser-widget-scraper",
  "version": "1.0.0",
  "description": "LaserWidget - Gestão de OSs & Editor de Planilhas",
  "main": "dist/electron/main.js",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "start:headed": "cross-env HEADLESS=false tsx src/index.ts",
    "start:bun": "bun src/index.ts",
    "convert": "tsx src/convert.ts",
    "dev:web": "concurrently \"bun src/server.ts\" \"vite\"",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "bun run build:renderer && bun run build:electron",
    "app": "bun run build:electron && concurrently \"bun src/server.ts\" \"vite\" \"cross-env ELECTRON_DEV_URL=http://localhost:5173 npx electron .\"",
    "app:headed": "bun run build:electron && concurrently \"bun src/server.ts\" \"vite\" \"cross-env ELECTRON_DEV_URL=http://localhost:5173 HEADLESS=false npx electron .\"",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "scraping",
    "automation",
    "playwright",
    "sqlite",
    "excel",
    "electron",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chart.js": "^4.5.1",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.33.0",
    "playwright": "^1.50.1",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^8.2.2"
  }
}
