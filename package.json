{
  "name": "laser-widget-scraper",
  "version": "1.0.0",
  "description": "Base de automação para web scraping e exportação de dados para Excel, CSV e SQLite em TypeScript com Bun",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "start:headed": "HEADLESS=false bun src/index.ts",
    "start:bun": "bun src/index.ts",
    "start:bun:headed": "HEADLESS=false bun src/index.ts",
    "start:node": "tsx src/index.ts",
    "convert": "bun src/convert.ts",
    "dev": "bun --watch src/index.ts",
    "check": "tsc --noEmit",
    "build": "tsc"
  },
  "keywords": [
    "scraping",
    "automation",
    "playwright",
    "sqlite",
    "bun",
    "excel",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "playwright": "^1.50.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
