# Configurações do Scraper
TARGET_URL=https://quotes.toscrape.com
HEADLESS=true
OUTPUT_FILE_PATH=./output/dados_raspados.xlsx

# Navegador da automação (opcional: auto, msedge, chrome, chromium)
# No Windows sem nada instalado, 'auto' usa automaticamente o Microsoft Edge nativo
BROWSER_CHANNEL=auto
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Credenciais de acesso (se o sistema necessitar de login)
SYSTEM_USER=seu_usuario
SYSTEM_PASSWORD=sua_senha

